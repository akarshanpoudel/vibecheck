# ---- Python -------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
*.egg
dist/
build/
.eggs/

# ---- Virtual environments -----------------------------------------
venv/
.venv/
env/
ENV/
